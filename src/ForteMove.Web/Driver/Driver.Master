<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Driver.Master.cs" Inherits="ForteMove.Web.Driver.DriverMaster" %>
<!DOCTYPE html><html lang="en"><head runat="server"><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title><%: Page.Title %> | ForteMove</title><link runat="server" href="~/Content/vendor/bootstrap.min.css" rel="stylesheet"/><link runat="server" href="~/Content/fortemove.css" rel="stylesheet"/></head><body class="admin-page"><form id="form1" runat="server"><div class="app-workspace"><header class="app-topbar"><a href="<%= ResolveUrl("~/Driver/Account.aspx") %>"><img src="<%= ResolveUrl("~/Content/Brand/fortemove-wordmark.png") %>" alt="ForteMove" style="height:32px"/></a><div class="account-menu"><asp:Label ID="lblName" runat="server" CssClass="account-name"/><asp:LinkButton ID="btnLogout" runat="server" CssClass="btn btn-outline-secondary btn-sm" Text="Sign out" OnClick="btnLogout_Click" CausesValidation="false"/></div></header><main class="app-main"><asp:ContentPlaceHolder ID="MainContent" runat="server"/></main></div></form></body></html>
