<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Driver.Master.cs" Inherits="ForteMove.Web.Driver.DriverMaster" %>
<!DOCTYPE html>
<html lang="en"><head runat="server"><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title><%: Page.Title %> | ForteMove</title><link rel="icon" type="image/png" href="<%= ResolveUrl("~/Content/Brand/fortemove-mark.png") %>"/><link runat="server" href="~/Content/vendor/bootstrap.min.css" rel="stylesheet"/><link runat="server" href="~/Content/fortemove.css" rel="stylesheet"/></head>
<body class="driver-page"><form id="form1" runat="server"><div class="driver-shell"><header class="driver-topbar"><a href="<%= ResolveUrl("~/Driver/Today.aspx") %>"><img src="<%= ResolveUrl("~/Content/Brand/fortemove-wordmark.png") %>" alt="ForteMove"/></a><div class="account-menu"><asp:Label ID="lblName" runat="server" CssClass="account-name"/><asp:LinkButton ID="btnLogout" runat="server" CssClass="btn btn-outline-secondary btn-sm" Text="Sign out" OnClick="btnLogout_Click" CausesValidation="false"/></div></header><nav class="driver-navigation" aria-label="Driver navigation"><asp:HyperLink ID="lnkToday" runat="server" NavigateUrl="~/Driver/Today.aspx">Today</asp:HyperLink><asp:HyperLink ID="lnkUpcoming" runat="server" NavigateUrl="~/Driver/Upcoming.aspx">Upcoming</asp:HyperLink><asp:HyperLink ID="lnkHistory" runat="server" NavigateUrl="~/Driver/History.aspx">History</asp:HyperLink><asp:HyperLink ID="lnkAccount" runat="server" NavigateUrl="~/Driver/Account.aspx">Account</asp:HyperLink></nav><main class="driver-main"><asp:ContentPlaceHolder ID="MainContent" runat="server"/></main></div></form></body></html>
