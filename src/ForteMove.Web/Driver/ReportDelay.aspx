<%@ Page Title="Report Delay" Language="C#" MasterPageFile="~/Driver/Driver.Master" AutoEventWireup="true" CodeBehind="ReportDelay.aspx.cs" Inherits="ForteMove.Web.Driver.ReportDelay" %><asp:Content ID="Content1" ContentPlaceHolderID="MainContent" runat="server"><header class="driver-heading"><p class="section-kicker">Trip update</p><h1>Report a delay</h1><p><asp:Literal ID="litContext" runat="server"/></p></header><asp:Panel ID="pnlError" runat="server" CssClass="alert alert-danger" Visible="false"><asp:Literal ID="litError" runat="server"/></asp:Panel><asp:HiddenField ID="hidTripRv" runat="server"/><asp:HiddenField ID="hidAssignmentRv" runat="server"/><section class="app-panel form-panel"><div class="mb-3"><asp:Label runat="server" AssociatedControlID="txtReason" CssClass="form-label" Text="Delay reason"/><asp:TextBox ID="txtReason" runat="server" CssClass="form-control" TextMode="MultiLine" Rows="4" MaxLength="500"/></div><div class="mb-3"><asp:Label runat="server" AssociatedControlID="txtEstimate" CssClass="form-label" Text="Estimated delay (minutes, optional)"/><asp:TextBox ID="txtEstimate" runat="server" CssClass="form-control" TextMode="Number" min="1"/></div><div class="form-actions"><asp:Button ID="btnSubmit" runat="server" CssClass="btn btn-primary" Text="Report delay" OnClick="btnSubmit_Click"/><a class="btn btn-link" href='<%= ResolveUrl("~/Driver/TripDetails.aspx?id="+Request.QueryString["id"]) %>'>Back</a></div></section></asp:Content>
