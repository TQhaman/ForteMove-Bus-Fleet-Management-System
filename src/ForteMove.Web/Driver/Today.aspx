<%@ Page Title="Today" Language="C#" MasterPageFile="~/Driver/Driver.Master" AutoEventWireup="true" CodeBehind="Today.aspx.cs" Inherits="ForteMove.Web.Driver.Today" %>
<asp:Content ID="Content1" ContentPlaceHolderID="MainContent" runat="server"><header class="driver-heading"><p class="section-kicker">Driver operations</p><h1>Today</h1><p>Your assigned services for today, including any overnight Trip still in progress.</p></header><asp:Panel ID="pnlAlert" runat="server" CssClass="alert alert-warning" Visible="false"><asp:Literal ID="litAlert" runat="server"/></asp:Panel><asp:Repeater ID="rptTrips" runat="server"><ItemTemplate><a class="driver-trip-card" href='<%# ResolveUrl("~/Driver/TripDetails.aspx?id="+Eval("TripId")) %>'><div class="d-flex justify-content-between gap-3"><span class="driver-trip-time"><%#: FormatTime(Eval("ScheduledDepartureTime")) %></span><span class='<%# StatusClass(Eval("Status")) %>'><%#: FormatStatus(Eval("Status")) %></span></div><strong><%#: Eval("RouteCode") %> · <%#: Eval("RouteName") %></strong><span class="driver-trip-meta"><%#: Eval("OriginName") %> to <%#: Eval("DestinationName") %></span><span class="driver-trip-meta">Bus <%#: Eval("FleetNumber") %></span><span class="text-danger fw-semibold"><%#: Overdue(Eval("IsOverdueNotStarted")) %></span></a></ItemTemplate></asp:Repeater><asp:Panel ID="pnlEmpty" runat="server" CssClass="app-panel empty-state" Visible="false"><h2>No assigned Trips today</h2><p>Your current assigned work will appear here.</p></asp:Panel></asp:Content>
