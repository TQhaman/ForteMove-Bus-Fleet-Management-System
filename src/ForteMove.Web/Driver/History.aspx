<%@ Page Title="Trip History" Language="C#" MasterPageFile="~/Driver/Driver.Master" AutoEventWireup="true" CodeBehind="History.aspx.cs" Inherits="ForteMove.Web.Driver.History" %><asp:Content ID="Content1" ContentPlaceHolderID="MainContent" runat="server"><header class="driver-heading"><p class="section-kicker">Driver operations</p><h1>History</h1><p>Your completed and cancelled Trips.</p></header><asp:Repeater ID="rptTrips" runat="server"><ItemTemplate><a class="driver-trip-card" href='<%# ResolveUrl("~/Driver/TripDetails.aspx?id="+Eval("TripId")) %>'><span class="driver-trip-time"><%#: FormatDate(Eval("ServiceDate")) %></span><strong class="d-block"><%#: Eval("TripCode") %> · <%#: Eval("RouteName") %></strong><span class="driver-trip-meta"><%#: Eval("FleetNumber") %> · <%#: Eval("Status") %></span></a></ItemTemplate></asp:Repeater><asp:Panel ID="pnlEmpty" runat="server" CssClass="app-panel empty-state" Visible="false"><h2>No Trip history yet</h2><p>Completed and cancelled Trips will appear here.</p></asp:Panel></asp:Content>
