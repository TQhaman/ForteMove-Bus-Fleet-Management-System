<%@ Page Title="Upcoming Trips" Language="C#" MasterPageFile="~/Driver/Driver.Master" AutoEventWireup="true" CodeBehind="Upcoming.aspx.cs" Inherits="ForteMove.Web.Driver.Upcoming" %><asp:Content ID="Content1" ContentPlaceHolderID="MainContent" runat="server"><header class="driver-heading"><p class="section-kicker">Driver operations</p><h1>Upcoming</h1><p>Your future assigned Trips.</p></header><asp:Repeater ID="rptTrips" runat="server"><ItemTemplate><a class="driver-trip-card" href='<%# ResolveUrl("~/Driver/TripDetails.aspx?id="+Eval("TripId")) %>'><span class="driver-trip-time"><%#: FormatDate(Eval("ServiceDate")) %> · <%#: FormatTime(Eval("ScheduledDepartureTime")) %></span><strong class="d-block"><%#: Eval("RouteCode") %> · <%#: Eval("RouteName") %></strong><span class="driver-trip-meta"><%#: Eval("OriginName") %> to <%#: Eval("DestinationName") %> · Bus <%#: Eval("FleetNumber") %></span></a></ItemTemplate></asp:Repeater><asp:Panel ID="pnlEmpty" runat="server" CssClass="app-panel empty-state" Visible="false"><h2>No upcoming assignments</h2><p>Future assigned Trips will appear here.</p></asp:Panel></asp:Content>
