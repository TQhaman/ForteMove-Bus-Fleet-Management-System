<%@ Page Title="Trip Details" Language="C#" MasterPageFile="~/Driver/Driver.Master" AutoEventWireup="true" CodeBehind="TripDetails.aspx.cs" Inherits="ForteMove.Web.Driver.TripDetailsPage" %>
<%@ Register Src="~/Controls/TripTrackingPanel.ascx" TagPrefix="fm" TagName="TripTracking" %>
<asp:Content ID="Content1" ContentPlaceHolderID="MainContent" runat="server"><header class="driver-heading"><p class="section-kicker">Assigned Trip</p><h1><asp:Literal ID="litTripCode" runat="server"/></h1><p><asp:Literal ID="litRoute" runat="server"/></p></header><asp:Panel ID="pnlMessage" runat="server" CssClass="alert alert-danger" Visible="false"><asp:Literal ID="litMessage" runat="server"/></asp:Panel><asp:Panel ID="pnlBlocked" runat="server" CssClass="alert alert-warning" Visible="false"><strong>Action required.</strong> <asp:Literal ID="litBlocked" runat="server"/></asp:Panel><asp:HiddenField ID="hidTripRv" runat="server"/><asp:HiddenField ID="hidAssignmentRv" runat="server"/><asp:HiddenField ID="hidExecutionRv" runat="server"/><asp:HiddenField ID="hidBusRv" runat="server"/>
<section class="app-panel form-panel"><div class="route-summary-grid"><div><span>Date</span><strong><asp:Literal ID="litDate" runat="server"/></strong></div><div><span>Departure</span><strong><asp:Literal ID="litDeparture" runat="server"/></strong></div><div><span>Bus</span><strong><asp:Literal ID="litBus" runat="server"/></strong></div><div><span>Status</span><strong><asp:Literal ID="litStatus" runat="server"/></strong></div></div><hr/><h2>Journey</h2><p class="fs-5 fw-semibold"><asp:Literal ID="litJourney" runat="server"/></p><ol><asp:Repeater ID="rptStops" runat="server"><ItemTemplate><li class="mb-2"><%#: Container.DataItem %></li></ItemTemplate></asp:Repeater></ol><asp:Panel ID="pnlTimes" runat="server" Visible="false"><p><strong>Actual start:</strong> <asp:Literal ID="litActualStart" runat="server"/><br/><strong>Actual completion:</strong> <asp:Literal ID="litActualCompletion" runat="server"/></p></asp:Panel>
<div class="driver-action-grid"><asp:HyperLink ID="lnkReadiness" runat="server" CssClass="btn btn-primary" Text="Complete pre-trip check"/><asp:Button ID="btnStart" runat="server" CssClass="btn btn-success" Text="Start Trip" OnClick="btnStart_Click"/><asp:Button ID="btnResume" runat="server" CssClass="btn btn-success" Text="Resume Trip" OnClick="btnResume_Click"/><asp:HyperLink ID="lnkDelay" runat="server" CssClass="btn btn-outline-primary" Text="Report delay"/><asp:HyperLink ID="lnkComplete" runat="server" CssClass="btn btn-primary" Text="Complete Trip"/><asp:HyperLink ID="lnkCannotProceed" runat="server" CssClass="btn btn-outline-danger" Text="Cannot proceed"/><asp:HyperLink ID="lnkDefect" runat="server" CssClass="btn btn-outline-secondary" Text="Report defect"/></div></section>
<fm:TripTracking ID="tracking" runat="server" />
<asp:Panel ID="pnlHistory" runat="server" CssClass="app-panel mt-4" Visible="false"><h2>Operational history</h2><ul class="timeline-list"><asp:Repeater ID="rptStatusHistory" runat="server"><ItemTemplate><li><strong><%#: FormatHistoryStatus(Eval("ToStatus")) %></strong><span class="cell-secondary"><%#: FormatOperationalTime(Eval("OccurredUtc")) %></span><span class="cell-tertiary"><%#: Eval("Note") %></span></li></ItemTemplate></asp:Repeater></ul></asp:Panel></asp:Content>
