<%@ Page Title="Report Defect" Language="C#" MasterPageFile="~/Driver/Driver.Master" AutoEventWireup="true" CodeBehind="ReportDefect.aspx.cs" Inherits="ForteMove.Web.Driver.ReportDefect" %><asp:Content ID="Content1" ContentPlaceHolderID="MainContent" runat="server"><header class="driver-heading"><p class="section-kicker">Vehicle safety</p><h1>Report a defect</h1><p><asp:Literal ID="litContext" runat="server"/></p></header><asp:Panel ID="pnlError" runat="server" CssClass="alert alert-danger" Visible="false"><asp:Literal ID="litError" runat="server"/></asp:Panel><asp:HiddenField ID="hidTripRv" runat="server"/><asp:HiddenField ID="hidAssignmentRv" runat="server"/><section class="app-panel form-panel"><div class="row g-3"><div class="col-md-6"><asp:Label runat="server" AssociatedControlID="ddlCategory" CssClass="form-label" Text="Category"/><asp:DropDownList ID="ddlCategory" runat="server" CssClass="form-select"/></div><div class="col-md-6"><asp:Label runat="server" AssociatedControlID="ddlSeverity" CssClass="form-label" Text="Severity"/><asp:DropDownList ID="ddlSeverity" runat="server" CssClass="form-select"/></div><div class="col-12"><asp:Label runat="server" AssociatedControlID="txtDescription" CssClass="form-label" Text="Description"/><asp:TextBox ID="txtDescription" runat="server" CssClass="form-control" TextMode="MultiLine" Rows="5" MaxLength="1000"/></div></div><div class="form-actions"><asp:Button ID="btnSubmit" runat="server" CssClass="btn btn-primary" Text="Submit defect report" OnClick="btnSubmit_Click"/><a class="btn btn-link" href='<%= ResolveUrl("~/Driver/TripDetails.aspx?id="+Request.QueryString["id"]) %>'>Back</a></div></section></asp:Content>
