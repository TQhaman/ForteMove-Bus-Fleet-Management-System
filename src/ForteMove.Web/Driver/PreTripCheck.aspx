<%@ Page Title="Pre-trip Check" Language="C#" MasterPageFile="~/Driver/Driver.Master" AutoEventWireup="true" CodeBehind="PreTripCheck.aspx.cs" Inherits="ForteMove.Web.Driver.PreTripCheck" %><asp:Content ID="Content1" ContentPlaceHolderID="MainContent" runat="server"><header class="driver-heading"><p class="section-kicker">Safety check</p><h1>Confirm readiness</h1><p><asp:Literal ID="litContext" runat="server"/></p></header><asp:Panel ID="pnlError" runat="server" CssClass="alert alert-danger" Visible="false"><asp:Literal ID="litError" runat="server"/></asp:Panel><asp:HiddenField ID="hidTripRv" runat="server"/><asp:HiddenField ID="hidAssignmentRv" runat="server"/><section class="driver-checklist"><asp:CheckBox ID="chkExterior" runat="server" CssClass="form-check" Text="Exterior condition checked"/><asp:CheckBox ID="chkTyres" runat="server" CssClass="form-check" Text="Tyres are safe"/><asp:CheckBox ID="chkLights" runat="server" CssClass="form-check" Text="Lights and indicators checked"/><asp:CheckBox ID="chkDashboard" runat="server" CssClass="form-check" Text="No Critical dashboard warning is present"/><asp:CheckBox ID="chkDoors" runat="server" CssClass="form-check" Text="Doors are operational"/><asp:CheckBox ID="chkEmergency" runat="server" CssClass="form-check" Text="Emergency equipment is present"/><asp:CheckBox ID="chkDefects" runat="server" CssClass="form-check" Text="No new defect prevents safe operation"/></section><section class="app-panel form-panel mt-3"><asp:Label runat="server" AssociatedControlID="txtOdometer" CssClass="form-label" Text="Starting odometer (km)"/><asp:TextBox ID="txtOdometer" runat="server" CssClass="form-control" TextMode="Number" step="0.1"/><p class="field-hint">The reading cannot be lower than the bus's current odometer.</p><div class="form-actions"><asp:Button ID="btnConfirm" runat="server" CssClass="btn btn-primary" Text="Confirm Trip ready" OnClick="btnConfirm_Click"/><a class="btn btn-link" href='<%= ResolveUrl("~/Driver/TripDetails.aspx?id="+Request.QueryString["id"]) %>'>Back</a></div></section></asp:Content>
