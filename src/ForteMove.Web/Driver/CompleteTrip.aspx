<%@ Page Title="Complete Trip" Language="C#" MasterPageFile="~/Driver/Driver.Master" AutoEventWireup="true" CodeBehind="CompleteTrip.aspx.cs" Inherits="ForteMove.Web.Driver.CompleteTrip" %><asp:Content ID="Content1" ContentPlaceHolderID="MainContent" runat="server"><header class="driver-heading"><p class="section-kicker">Trip completion</p><h1>Complete Trip</h1><p><asp:Literal ID="litContext" runat="server"/></p></header><asp:Panel ID="pnlError" runat="server" CssClass="alert alert-danger" Visible="false"><asp:Literal ID="litError" runat="server"/></asp:Panel><asp:HiddenField ID="hidTripRv" runat="server"/><asp:HiddenField ID="hidAssignmentRv" runat="server"/><asp:HiddenField ID="hidExecutionRv" runat="server"/><asp:HiddenField ID="hidBusRv" runat="server"/><section class="app-panel form-panel"><div class="mb-3"><asp:Label runat="server" AssociatedControlID="txtOdometer" CssClass="form-label" Text="Ending odometer (km)"/><asp:TextBox ID="txtOdometer" runat="server" CssClass="form-control" TextMode="Number" step="0.1"/><p class="field-hint">Must be at least the starting reading and current bus odometer.</p></div><div class="mb-3"><asp:Label runat="server" AssociatedControlID="txtNote" CssClass="form-label" Text="Completion note (optional)"/><asp:TextBox ID="txtNote" runat="server" CssClass="form-control" TextMode="MultiLine" Rows="4" MaxLength="1000"/></div><div class="form-actions"><asp:Button ID="btnComplete" runat="server" CssClass="btn btn-primary" Text="Complete Trip" OnClick="btnComplete_Click"/><a class="btn btn-link" href='<%= ResolveUrl("~/Driver/TripDetails.aspx?id="+Request.QueryString["id"]) %>'>Back</a></div></section></asp:Content>
