<%@ Page Title="Cannot Proceed" Language="C#" MasterPageFile="~/Driver/Driver.Master" AutoEventWireup="true" CodeBehind="CannotProceed.aspx.cs" Inherits="ForteMove.Web.Driver.CannotProceed" %><asp:Content ID="Content1" ContentPlaceHolderID="MainContent" runat="server"><header class="driver-heading"><p class="section-kicker">Operational exception</p><h1>Cannot proceed</h1><p><asp:Literal ID="litContext" runat="server"/></p></header><div class="alert alert-warning">This report alerts Transport Administration and blocks operational actions until it is resolved. Use Report defect separately when safety information must also be recorded.</div><asp:Panel ID="pnlError" runat="server" CssClass="alert alert-danger" Visible="false"><asp:Literal ID="litError" runat="server"/></asp:Panel><asp:HiddenField ID="hidTripRv" runat="server"/><asp:HiddenField ID="hidAssignmentRv" runat="server"/><section class="app-panel form-panel"><div class="mb-3"><asp:Label runat="server" AssociatedControlID="txtReason" CssClass="form-label" Text="Why can the Trip not proceed?"/><asp:TextBox ID="txtReason" runat="server" CssClass="form-control" TextMode="MultiLine" Rows="3" MaxLength="500"/></div><div class="mb-3"><asp:Label runat="server" AssociatedControlID="txtNote" CssClass="form-label" Text="Additional note (optional)"/><asp:TextBox ID="txtNote" runat="server" CssClass="form-control" TextMode="MultiLine" Rows="3" MaxLength="1000"/></div><div class="form-actions"><asp:Button ID="btnSubmit" runat="server" CssClass="btn btn-danger" Text="Send Cannot Proceed report" OnClick="btnSubmit_Click"/><a class="btn btn-link" href='<%= ResolveUrl("~/Driver/TripDetails.aspx?id="+Request.QueryString["id"]) %>'>Back</a></div></section></asp:Content>
