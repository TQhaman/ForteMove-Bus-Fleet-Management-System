<%@ Page Title="Active Fuel Vouchers" Language="C#" MasterPageFile="~/Driver/Driver.Master" AutoEventWireup="true" CodeBehind="Vouchers.aspx.cs" Inherits="ForteMove.Web.Driver.Fuel.VouchersPage"  %>
<asp:Content ID="Main" ContentPlaceHolderID="MainContent" runat="server">
<header class="driver-heading"><div><p class="section-kicker">Fuel</p><h1>Active Fuel Vouchers</h1></div></header>
<nav class="fuel-subnavigation" aria-label="Fuel navigation"><a  href="<%= ResolveUrl("~/Driver/Fuel/Requests.aspx") %>">Requests</a><a aria-current="page" class="active" href="<%= ResolveUrl("~/Driver/Fuel/Vouchers.aspx") %>">Active Vouchers</a><a  href="<%= ResolveUrl("~/Driver/Fuel/History.aspx") %>">History</a></nav>
<asp:Panel ID="pnlMessage" runat="server" CssClass="alert alert-danger" Visible="false" role="alert"><asp:Literal ID="litMessage" runat="server"/></asp:Panel>
<section class="app-panel"><div class="fuel-filter-row"><div class="form-field"><label for="<%= txtSearch.ClientID %>">Search</label><asp:TextBox ID="txtSearch" runat="server" CssClass="form-control" MaxLength="100"/></div><div class="form-field"><label for="<%= ddlStatus.ClientID %>">Status</label><asp:DropDownList ID="ddlStatus" runat="server" CssClass="form-select"/></div><asp:Button ID="btnFilter" runat="server" Text="Apply filters" CssClass="btn btn-primary" OnClick="Filter"/></div><div class="table-responsive"><asp:GridView ID="grid" runat="server" AutoGenerateColumns="false" CssClass="table app-table" EmptyDataText="No Fuel Vouchers match these filters."><Columns><asp:HyperLinkField HeaderText="Voucher" DataTextField="Code" DataNavigateUrlFields="Id" DataNavigateUrlFormatString="VoucherDetails.aspx?id={0}"/><asp:BoundField HeaderText="Trip" DataField="Trip"/><asp:BoundField HeaderText="Bus" DataField="Bus"/><asp:BoundField HeaderText="Supply" DataField="Supply"/><asp:BoundField HeaderText="Quantity" DataField="Quantity"/><asp:BoundField HeaderText="Value" DataField="Amount"/><asp:BoundField HeaderText="Station" DataField="Station"/><asp:BoundField HeaderText="Valid until" DataField="Until"/><asp:BoundField HeaderText="Status" DataField="State"/></Columns></asp:GridView></div></section>
</asp:Content>
