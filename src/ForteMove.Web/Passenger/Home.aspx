<%@ Page Title="Home" Language="C#" MasterPageFile="~/Passenger/Passenger.Master" AutoEventWireup="true" CodeBehind="Home.aspx.cs" Inherits="ForteMove.Web.Passenger.Home" %>
<asp:Content ID="Content1" ContentPlaceHolderID="MainContent" runat="server">
<header class="passenger-heading"><p class="section-kicker">Passenger portal</p><h1>Welcome, <asp:Literal ID="litName" runat="server" /></h1><p>Plan your next journey and keep your wallet ready.</p></header>
<section class="passenger-balance-card"><div><span>Wallet balance</span><strong><asp:Literal ID="litBalance" runat="server" /></strong></div><a class="btn btn-light" href="<%= ResolveUrl("~/Passenger/Wallet.aspx") %>">Top up</a></section>
<div class="passenger-action-grid"><a class="passenger-action-card" href="<%= ResolveUrl("~/Passenger/Journeys.aspx") %>"><strong>Find a journey</strong><span>View future scheduled services and buy a Ticket.</span></a><a class="passenger-action-card" href="<%= ResolveUrl("~/Passenger/Tickets.aspx") %>"><strong>My Tickets</strong><span>See upcoming and past Tickets.</span></a></div>
<section class="app-panel mt-4"><div class="panel-heading-simple"><h2>Next journey</h2></div><asp:Panel ID="pnlNext" runat="server"><a class="passenger-ticket-card" runat="server" id="lnkNext"><span class="cell-secondary"><asp:Literal ID="litNextDate" runat="server" /></span><strong><asp:Literal ID="litNextRoute" runat="server" /></strong><span><asp:Literal ID="litNextEndpoints" runat="server" /></span></a></asp:Panel><asp:Panel ID="pnlNoNext" runat="server" CssClass="compact-empty"><p>No upcoming purchased Ticket.</p><a href="<%= ResolveUrl("~/Passenger/Journeys.aspx") %>">Find a journey</a></asp:Panel></section>
<section class="app-panel mt-4"><div class="panel-heading-simple"><h2>Recent wallet activity</h2></div><asp:Repeater ID="rptActivity" runat="server"><ItemTemplate><div class="wallet-entry"><div><strong><%#: FormatTransaction(Eval("TransactionType")) %></strong><span><%#: FormatOccurred(Eval("OccurredUtc")) %></span></div><div class="text-end"><strong><%#: FormatAmount(Eval("TransactionType"), Eval("Amount")) %></strong><span>Balance <%#: Eval("BalanceAfter", "{0:C}") %></span></div></div></ItemTemplate></asp:Repeater><asp:Panel ID="pnlNoActivity" runat="server" CssClass="compact-empty"><p>No wallet activity yet.</p></asp:Panel></section>
</asp:Content>
