<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Passenger.Master.cs" Inherits="ForteMove.Web.Passenger.PassengerMaster" %>
<!DOCTYPE html>
<html lang="en"><head runat="server"><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title><%: Page.Title %> | ForteMove</title><link rel="icon" type="image/png" href="<%= ResolveUrl("~/Content/Brand/fortemove-mark.png") %>"/><link runat="server" href="~/Content/vendor/bootstrap.min.css" rel="stylesheet"/><link runat="server" href="~/Content/fortemove.css" rel="stylesheet"/></head>
<body class="passenger-page"><form id="form1" runat="server"><div class="passenger-shell"><header class="passenger-topbar"><a href="<%= ResolveUrl("~/Passenger/Home.aspx") %>"><img src="<%= ResolveUrl("~/Content/Brand/fortemove-wordmark.png") %>" alt="ForteMove"/></a><div class="account-menu"><asp:Label ID="lblName" runat="server" CssClass="account-name"/><asp:LinkButton ID="btnLogout" runat="server" CssClass="btn btn-outline-light btn-sm" Text="Sign out" OnClick="btnLogout_Click" CausesValidation="false"/></div></header><nav class="passenger-navigation" aria-label="Passenger navigation"><asp:HyperLink ID="lnkHome" runat="server" NavigateUrl="~/Passenger/Home.aspx">Home</asp:HyperLink><asp:HyperLink ID="lnkJourneys" runat="server" NavigateUrl="~/Passenger/Journeys.aspx">Journeys</asp:HyperLink><asp:HyperLink ID="lnkTickets" runat="server" NavigateUrl="~/Passenger/Tickets.aspx">Tickets</asp:HyperLink><asp:HyperLink ID="lnkWallet" runat="server" NavigateUrl="~/Passenger/Wallet.aspx">Wallet</asp:HyperLink><asp:HyperLink ID="lnkAccount" runat="server" NavigateUrl="~/Passenger/Account.aspx">Account</asp:HyperLink></nav><main class="passenger-main"><asp:ContentPlaceHolder ID="MainContent" runat="server"/></main></div></form></body></html>
