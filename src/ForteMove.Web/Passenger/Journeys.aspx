<%@ Page Title="Journeys" Language="C#" MasterPageFile="~/Passenger/Passenger.Master" AutoEventWireup="true" CodeBehind="Journeys.aspx.cs" Inherits="ForteMove.Web.Passenger.Journeys" %>
<asp:Content ID="Content1" ContentPlaceHolderID="MainContent" runat="server">
<header class="passenger-heading"><p class="section-kicker">Scheduled services</p><h1>Find a journey</h1><p>Choose a future service and review the fare before purchasing.</p></header>
<asp:Panel ID="pnlErrors" runat="server" CssClass="alert alert-danger" Visible="false"><asp:Repeater ID="rptErrors" runat="server"><ItemTemplate><div><%#: Eval("Message") %></div></ItemTemplate></asp:Repeater></asp:Panel>
<section class="app-panel form-panel mb-4"><div class="row g-3 align-items-end"><div class="col-sm-5"><asp:Label runat="server" AssociatedControlID="txtDate" CssClass="form-label" Text="Journey date"/><asp:TextBox ID="txtDate" runat="server" CssClass="form-control" TextMode="Date"/></div><div class="col-sm-7"><asp:Label runat="server" AssociatedControlID="ddlRoute" CssClass="form-label" Text="Route"/><asp:DropDownList ID="ddlRoute" runat="server" CssClass="form-select"/></div><div class="col-12"><asp:Label runat="server" AssociatedControlID="txtSearch" CssClass="form-label" Text="Origin, destination or Route"/><asp:TextBox ID="txtSearch" runat="server" CssClass="form-control" MaxLength="100" placeholder="Search by stop or Route name"/></div><div class="col-12"><asp:Button ID="btnFind" runat="server" CssClass="btn btn-primary" Text="Find journeys" OnClick="btnFind_Click"/></div></div></section>
<asp:Repeater ID="rptJourneys" runat="server"><ItemTemplate><a class="passenger-journey-card" href='<%# ResolveUrl("~/Passenger/JourneyDetails.aspx?id="+Eval("TripId")) %>'><div class="d-flex justify-content-between gap-3"><span class="passenger-journey-time"><%#: FormatTime(Eval("ScheduledDepartureTime")) %></span><span class="status-pill status-operational"><%#: FormatStatus(Eval("TripStatus")) %></span></div><strong><%#: Eval("RouteCode") %> - <%#: Eval("RouteName") %></strong><span><%#: Eval("OriginName") %> to <%#: Eval("DestinationName") %></span><div class="passenger-card-footer"><span><%#: Eval("RemainingSeats") %> seats remaining</span><strong><%#: Eval("Fare", "{0:C}") %></strong></div><span class="text-warning fw-semibold"><%#: DelayText(Eval("EstimatedDelayMinutes")) %></span></a></ItemTemplate></asp:Repeater>
<asp:Panel ID="pnlEmpty" runat="server" CssClass="app-panel empty-state" Visible="false"><h2>No available journeys</h2><p>Try another date or Route. Only services currently open for Ticket purchases appear here.</p></asp:Panel>
</asp:Content>
