<%@ Page Title="Ticket details" Language="C#" MasterPageFile="~/Passenger/Passenger.Master" AutoEventWireup="true" CodeBehind="TicketDetails.aspx.cs" Inherits="ForteMove.Web.Passenger.TicketDetailsPage" %>
<asp:Content ID="Content1" ContentPlaceHolderID="MainContent" runat="server">
<header class="passenger-heading page-heading-with-action"><div><p class="section-kicker">Digital journey Ticket</p><h1><asp:Literal ID="litTicketCode" runat="server" /></h1><p><asp:Literal ID="litStatus" runat="server" /></p></div><a class="btn btn-outline-secondary" href="<%= ResolveUrl("~/Passenger/Tickets.aspx") %>">All Tickets</a></header>
<asp:Panel ID="pnlPurchased" runat="server" CssClass="alert alert-success" Visible="false">Ticket purchased successfully. Your wallet has been updated.</asp:Panel>
<asp:Panel ID="pnlDetails" runat="server" CssClass="passenger-ticket-detail" Visible="false"><div class="ticket-brand"><img src="<%= ResolveUrl("~/Content/Brand/fortemove-wordmark.png") %>" alt="ForteMove"/><span><asp:Literal ID="litTicketBadge" runat="server" /></span></div><h2><asp:Literal ID="litRoute" runat="server" /></h2><p class="ticket-route"><asp:Literal ID="litEndpoints" runat="server" /></p><div class="route-summary-grid"><div><span>Service</span><strong><asp:Literal ID="litService" runat="server" /></strong></div><div><span>Expected finish</span><strong><asp:Literal ID="litFinish" runat="server" /></strong></div><div><span>Fare paid</span><strong><asp:Literal ID="litFare" runat="server" /></strong></div><div><span>Bus</span><strong><asp:Literal ID="litFleet" runat="server" /></strong></div></div><asp:Panel ID="pnlDelay" runat="server" CssClass="alert alert-warning mt-3" Visible="false"><asp:Literal ID="litDelay" runat="server" /></asp:Panel><asp:Panel ID="pnlRefund" runat="server" CssClass="alert alert-info mt-3" Visible="false"><strong>Refunded.</strong> <asp:Literal ID="litRefund" runat="server" /></asp:Panel><p class="ticket-note">Keep this Ticket available for your journey. Boarding validation will be introduced in a later service update.</p></asp:Panel>
<asp:Panel ID="pnlNotFound" runat="server" CssClass="app-panel empty-state" Visible="false"><h2>Ticket not found</h2><p>This Ticket does not belong to your account or is unavailable.</p></asp:Panel>
<asp:HyperLink ID="lnkTrackTrip" runat="server" CssClass="btn btn-primary mt-3" Text="Track trip" Visible="false" />
</asp:Content>
