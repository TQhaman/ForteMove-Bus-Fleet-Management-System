<%@ Page Title="Tickets" Language="C#" MasterPageFile="~/Passenger/Passenger.Master" AutoEventWireup="true" CodeBehind="Tickets.aspx.cs" Inherits="ForteMove.Web.Passenger.Tickets" %>
<asp:Content ID="Content1" ContentPlaceHolderID="MainContent" runat="server">
<header class="passenger-heading page-heading-with-action"><div><p class="section-kicker">Your journeys</p><h1>Tickets</h1><p>Upcoming Tickets and retained purchase history.</p></div><a class="btn btn-primary" href="<%= ResolveUrl("~/Passenger/Journeys.aspx") %>">Find journey</a></header>
<section class="mb-4"><h2 class="h4 mb-3">Upcoming</h2><asp:Repeater ID="rptUpcoming" runat="server"><ItemTemplate><a class="passenger-ticket-card" href='<%# ResolveUrl("~/Passenger/TicketDetails.aspx?id="+Eval("TicketId")) %>'><div class="d-flex justify-content-between gap-3"><span class="cell-secondary"><%#: FormatService(Eval("ServiceDate"),Eval("ScheduledDepartureTime")) %></span><span class="status-pill status-operational"><%#: Eval("TicketStatus") %></span></div><strong><%#: Eval("RouteCode") %> - <%#: Eval("RouteName") %></strong><span><%#: Eval("OriginName") %> to <%#: Eval("DestinationName") %></span><div class="passenger-card-footer"><span><%#: Eval("TicketCode") %></span><strong><%#: Eval("FareAmount","{0:C}") %></strong></div></a></ItemTemplate></asp:Repeater><asp:Panel ID="pnlNoUpcoming" runat="server" CssClass="app-panel compact-empty"><p>No upcoming Tickets.</p></asp:Panel></section>
<section><h2 class="h4 mb-3">Ticket history</h2><asp:Repeater ID="rptHistory" runat="server"><ItemTemplate><a class="passenger-ticket-card passenger-ticket-history" href='<%# ResolveUrl("~/Passenger/TicketDetails.aspx?id="+Eval("TicketId")) %>'><div class="d-flex justify-content-between gap-3"><span class="cell-secondary"><%#: FormatService(Eval("ServiceDate"),Eval("ScheduledDepartureTime")) %></span><span class="status-pill"><%#: HistoryLabel(Eval("TicketStatus")) %></span></div><strong><%#: Eval("RouteCode") %> - <%#: Eval("RouteName") %></strong><span><%#: Eval("OriginName") %> to <%#: Eval("DestinationName") %></span><div class="passenger-card-footer"><span><%#: Eval("TicketCode") %></span><strong><%#: Eval("FareAmount","{0:C}") %></strong></div></a></ItemTemplate></asp:Repeater><asp:Panel ID="pnlNoHistory" runat="server" CssClass="app-panel compact-empty"><p>No past or refunded Tickets.</p></asp:Panel></section>
</asp:Content>
