<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="ForteMove"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=ForteMove;Integrated Security=True;Application Name=ForteMove.Web"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8"
                 enableVersionHeader="false"
                 requestValidationMode="4.5"
                 maxRequestLength="4096"
                 executionTimeout="110" />
    <authentication mode="Forms">
      <forms name=".ForteMove.Auth"
             loginUrl="~/Account/Login.aspx"
             timeout="30"
             protection="All"
             requireSSL="true"
             cookieless="UseCookies"
             slidingExpiration="false"
             path="/"
             cookieSameSite="Lax" />
    </authentication>
    <authorization>
      <allow users="*" />
    </authorization>
    <httpCookies httpOnlyCookies="true" requireSSL="true" sameSite="Lax" />
    <sessionState cookieless="UseCookies" cookieSameSite="Lax" timeout="20" />
    <customErrors mode="On" defaultRedirect="~/Errors/Unexpected.aspx" />
    <pages validateRequest="true"
           controlRenderingCompatibilityVersion="4.0"
           clientIDMode="Predictable" />
  </system.web>

  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <httpErrors errorMode="DetailedLocalOnly" existingResponse="PassThrough" />
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
