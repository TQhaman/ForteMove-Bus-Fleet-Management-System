<%@ Page Title="Drivers" Language="C#" MasterPageFile="~/Admin/Admin.Master" AutoEventWireup="true" CodeBehind="DriverList.aspx.cs" Inherits="ForteMove.Web.Admin.Drivers.DriverList" %>
<asp:Content ID="Content1" ContentPlaceHolderID="MainContent" runat="server"><header class="page-heading page-heading-with-action"><div><p class="section-kicker">People</p><h1>Drivers</h1><p>Review Driver availability and credential readiness.</p></div><a class="btn btn-primary" href="<%= ResolveUrl("~/Admin/Drivers/CreateDriver.aspx") %>">Create Driver</a></header>
<asp:Panel ID="pnlFlash" runat="server" CssClass="alert alert-success" Visible="false"><asp:Literal ID="litFlash" runat="server"/></asp:Panel>
<section class="app-panel filter-panel"><div class="row g-3"><div class="col-md-5"><asp:Label runat="server" AssociatedControlID="txtSearch" CssClass="form-label" Text="Search"/><asp:TextBox ID="txtSearch" runat="server" CssClass="form-control" placeholder="Name, employee number, email or credential"/></div><div class="col-md-3"><asp:Label runat="server" AssociatedControlID="ddlAvailability" CssClass="form-label" Text="Availability"/><asp:DropDownList ID="ddlAvailability" runat="server" CssClass="form-select"><asp:ListItem Text="All" Value=""/><asp:ListItem Text="Available"/><asp:ListItem Text="Unavailable"/><asp:ListItem Text="On leave" Value="OnLeave"/><asp:ListItem Text="Suspended"/></asp:DropDownList></div><div class="col-md-3"><asp:Label runat="server" AssociatedControlID="ddlCredentials" CssClass="form-label" Text="Credentials"/><asp:DropDownList ID="ddlCredentials" runat="server" CssClass="form-select"><asp:ListItem Text="All" Value=""/><asp:ListItem Text="Valid"/><asp:ListItem Text="Expiring soon" Value="ExpiringSoon"/><asp:ListItem Text="Expired"/></asp:DropDownList></div><div class="col-md-1 d-flex align-items-end"><asp:Button ID="btnApply" runat="server" CssClass="btn btn-primary" Text="Apply" OnClick="btnApply_Click"/></div></div></section>
<section class="app-panel mt-4"><div class="table-responsive"><table class="table fleet-table align-middle mb-0"><thead><tr><th>Driver</th><th>Contact</th><th>Availability</th><th>Licence</th><th>PrDP</th><th></th></tr></thead><tbody><asp:Repeater ID="rptDrivers" runat="server"><ItemTemplate><tr><td><strong><%#: Eval("FullName") %></strong><span class="cell-secondary"><%#: Eval("EmployeeNumber") %></span></td><td><%#: Eval("Email") %></td><td><span class='<%# GetAvailabilityCss(Eval("AvailabilityStatus")) %>'><%#: FormatAvailability(Eval("AvailabilityStatus")) %></span></td><td><%#: Eval("LicenceCode") %><span class="cell-secondary"><%#: Eval("LicenceExpiryDate", "{0:d}") %></span></td><td><span class='<%# GetCredentialCss(Eval("CredentialStatus")) %>'><%#: FormatCredential(Eval("CredentialStatus")) %></span><span class="cell-secondary"><%#: Eval("PrdpExpiryDate", "{0:d}") %></span></td><td><a href='<%# ResolveUrl("~/Admin/Drivers/DriverDetails.aspx?id="+Eval("DriverProfileId")) %>'>View</a></td></tr></ItemTemplate></asp:Repeater></tbody></table></div><asp:Panel ID="pnlEmpty" runat="server" CssClass="empty-state" Visible="false"><h2>No Drivers match this view</h2><p>Create a Driver or adjust the filters.</p></asp:Panel></section></asp:Content>
