<%@ Page Title="Create Driver" Language="C#" MasterPageFile="~/Admin/Admin.Master" AutoEventWireup="true" CodeBehind="CreateDriver.aspx.cs" Inherits="ForteMove.Web.Admin.Drivers.CreateDriver" %>
<asp:Content ID="Content1" ContentPlaceHolderID="MainContent" runat="server"><header class="page-heading page-heading-with-action"><div><p class="section-kicker">Drivers</p><h1>Create Driver</h1><p>Create the staff account and capture assignment credentials.</p></div><a class="btn btn-outline-secondary" href="<%= ResolveUrl("~/Admin/Drivers/DriverList.aspx") %>">Driver list</a></header><asp:Panel ID="pnlErrors" runat="server" CssClass="alert alert-danger" Visible="false"><asp:Repeater ID="rptErrors" runat="server"><HeaderTemplate><ul class="mb-0"></HeaderTemplate><ItemTemplate><li><%#: Eval("Message") %></li></ItemTemplate><FooterTemplate></ul></FooterTemplate></asp:Repeater></asp:Panel>
<section class="app-panel form-panel"><div class="row g-4"><div class="col-md-4"><label class="form-label">Employee number</label><asp:TextBox ID="txtEmployeeNumber" runat="server" CssClass="form-control" ReadOnly="true"/></div><div class="col-md-4"><label class="form-label">First name</label><asp:TextBox ID="txtFirstName" runat="server" CssClass="form-control" MaxLength="100"/></div><div class="col-md-4"><label class="form-label">Last name</label><asp:TextBox ID="txtLastName" runat="server" CssClass="form-control" MaxLength="100"/></div><div class="col-md-4"><label class="form-label">Email</label><asp:TextBox ID="txtEmail" runat="server" CssClass="form-control" TextMode="Email" MaxLength="254"/></div><div class="col-md-4"><label class="form-label">Phone</label><asp:TextBox ID="txtPhone" runat="server" CssClass="form-control" MaxLength="30"/></div><div class="col-md-4"><label class="form-label">Date of birth</label><asp:TextBox ID="txtDateOfBirth" runat="server" CssClass="form-control" TextMode="Date"/></div><div class="col-md-4"><label class="form-label">Availability</label><asp:DropDownList ID="ddlAvailability" runat="server" CssClass="form-select"><asp:ListItem Text="Available"/><asp:ListItem Text="Unavailable"/><asp:ListItem Text="On leave" Value="OnLeave"/><asp:ListItem Text="Suspended"/></asp:DropDownList></div><div class="col-md-4"><label class="form-label">Temporary password</label><asp:TextBox ID="txtTemporaryPassword" runat="server" CssClass="form-control" TextMode="Password" MaxLength="128"/><div class="form-text">15–128 characters. The Driver must replace it on first login.</div></div></div></section>
<section class="app-panel form-panel mt-4"><h2>Licence and PrDP</h2><div class="row g-4"><div class="col-md-4"><label class="form-label">Licence number</label><asp:TextBox ID="txtLicenceNumber" runat="server" CssClass="form-control" MaxLength="50"/></div><div class="col-md-4"><label class="form-label">Licence code</label><asp:DropDownList ID="ddlLicenceCode" runat="server" CssClass="form-select"><asp:ListItem Text="Select" Value=""/><asp:ListItem Text="B"/><asp:ListItem Text="EB"/><asp:ListItem Text="C1"/><asp:ListItem Text="C"/><asp:ListItem Text="EC1"/><asp:ListItem Text="EC"/></asp:DropDownList></div><div class="col-md-4"><label class="form-label">Licence expiry</label><asp:TextBox ID="txtLicenceExpiry" runat="server" CssClass="form-control" TextMode="Date"/></div><div class="col-md-4"><label class="form-label">PrDP number</label><asp:TextBox ID="txtPrdpNumber" runat="server" CssClass="form-control" MaxLength="50"/></div><div class="col-md-4"><label class="form-label">PrDP category</label><input class="form-control" value="P — Passenger" readonly="readonly"/></div><div class="col-md-4"><label class="form-label">PrDP expiry</label><asp:TextBox ID="txtPrdpExpiry" runat="server" CssClass="form-control" TextMode="Date"/></div></div></section><div class="form-actions"><asp:Button ID="btnSave" runat="server" CssClass="btn btn-primary" Text="Create Driver" OnClick="btnSave_Click"/></div></asp:Content>
