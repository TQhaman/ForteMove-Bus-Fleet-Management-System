<%@ Page Title="Defect Reports" Language="C#" MasterPageFile="~/Admin/Admin.Master" AutoEventWireup="true" CodeBehind="Defects.aspx.cs" Inherits="ForteMove.Web.Admin.Operations.Defects" %><asp:Content ID="Content1" ContentPlaceHolderID="MainContent" runat="server"><header class="page-heading"><div><p class="section-kicker">Operations</p><h1>Defect reports</h1><p>Review Driver-reported vehicle defects and safety blockers.</p></div></header><section class="app-panel filter-panel"><div class="row g-3 align-items-end"><div class="col-md-4"><asp:Label runat="server" AssociatedControlID="ddlStatus" CssClass="form-label" Text="Status"/><asp:DropDownList ID="ddlStatus" runat="server" CssClass="form-select"/></div><div class="col-md-4"><asp:Label runat="server" AssociatedControlID="ddlSeverity" CssClass="form-label" Text="Severity"/><asp:DropDownList ID="ddlSeverity" runat="server" CssClass="form-select"/></div><div class="col-md-4"><asp:Button ID="btnApply" runat="server" CssClass="btn btn-primary" Text="Apply" OnClick="btnApply_Click"/></div></div></section><asp:Panel ID="pnlResults" runat="server" CssClass="app-panel route-panel"><div class="table-responsive"><table class="table route-table align-middle mb-0"><thead><tr><th>Report</th><th>Bus</th><th>Trip</th><th>Category</th><th>Severity</th><th>Reported by</th><th>Status</th></tr></thead><tbody><asp:Repeater ID="rptItems" runat="server"><ItemTemplate><tr><td><a href='<%# ResolveUrl("~/Admin/Operations/DefectDetails.aspx?id="+Eval("BusDefectReportId")) %>'><strong><%#: Eval("DefectCode") %></strong></a><span class="cell-secondary"><%#: FormatTime(Eval("ReportedUtc")) %></span></td><td><%#: Eval("FleetNumber") %></td><td><%#: Eval("TripCode") %></td><td><%#: FormatCategory(Eval("Category")) %></td><td><span class='<%# SeverityClass(Eval("Severity")) %>'><%#: Eval("Severity") %></span></td><td><%#: Eval("EmployeeNumber") %><span class="cell-secondary"><%#: Eval("DriverName") %></span></td><td><%#: Eval("Status") %></td></tr></ItemTemplate></asp:Repeater></tbody></table></div></asp:Panel><asp:Panel ID="pnlEmpty" runat="server" CssClass="app-panel empty-state" Visible="false"><h2>No defects match this view</h2><p>Adjust the filters or wait for a Driver report.</p></asp:Panel></asp:Content>
