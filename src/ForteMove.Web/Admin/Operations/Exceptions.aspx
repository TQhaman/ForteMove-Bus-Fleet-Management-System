<%@ Page Title="Operational Exceptions" Language="C#" MasterPageFile="~/Admin/Admin.Master" AutoEventWireup="true" CodeBehind="Exceptions.aspx.cs" Inherits="ForteMove.Web.Admin.Operations.Exceptions" %><asp:Content ID="Content1" ContentPlaceHolderID="MainContent" runat="server"><header class="page-heading"><div><p class="section-kicker">Operations</p><h1>Cannot Proceed reports</h1><p>Review Driver-reported blockers and record the operational decision.</p></div></header><section class="app-panel filter-panel"><asp:CheckBox ID="chkOpenOnly" runat="server" Text=" Show open reports only" Checked="true" AutoPostBack="true" OnCheckedChanged="chkOpenOnly_CheckedChanged"/></section><asp:Panel ID="pnlResults" runat="server" CssClass="app-panel route-panel"><div class="table-responsive"><table class="table route-table align-middle mb-0"><thead><tr><th>Trip</th><th>Driver</th><th>Bus</th><th>Phase</th><th>Reason</th><th>Reported</th><th>Status</th></tr></thead><tbody><asp:Repeater ID="rptItems" runat="server"><ItemTemplate><tr><td><a href='<%# ResolveUrl("~/Admin/Operations/ExceptionDetails.aspx?id="+Eval("TripCannotProceedReportId")) %>'><strong><%#: Eval("TripCode") %></strong></a><span class="cell-secondary"><%#: Eval("RouteName") %></span></td><td><%#: Eval("EmployeeNumber") %><span class="cell-secondary"><%#: Eval("DriverName") %></span></td><td><%#: Eval("FleetNumber") %></td><td><%#: Eval("Phase") %></td><td><%#: Eval("Reason") %></td><td><%#: FormatTime(Eval("ReportedUtc")) %></td><td><span class='<%# Convert.ToBoolean(Eval("IsOpen"))?"status-badge status-warning":"status-badge status-success" %>'><%#: Convert.ToBoolean(Eval("IsOpen"))?"Open":"Resolved" %></span></td></tr></ItemTemplate></asp:Repeater></tbody></table></div></asp:Panel><asp:Panel ID="pnlEmpty" runat="server" CssClass="app-panel empty-state" Visible="false"><h2>No reports match this view</h2><p>Open Cannot Proceed reports will appear here.</p></asp:Panel></asp:Content>
