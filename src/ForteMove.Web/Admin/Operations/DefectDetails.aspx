<%@ Page Title="Defect Details" Language="C#" MasterPageFile="~/Admin/Admin.Master" AutoEventWireup="true" CodeBehind="DefectDetails.aspx.cs" Inherits="ForteMove.Web.Admin.Operations.DefectDetails" %><asp:Content ID="Content1" ContentPlaceHolderID="MainContent" runat="server"><header class="page-heading page-heading-with-action"><div><p class="section-kicker">Vehicle defect</p><h1><asp:Literal ID="litCode" runat="server"/></h1><p>Bus <asp:Literal ID="litBus" runat="server"/></p></div><a class="btn btn-outline-secondary" href="<%= ResolveUrl("~/Admin/Operations/Defects.aspx") %>">Back to defects</a></header><asp:Panel ID="pnlMessage" runat="server" CssClass="alert alert-danger" Visible="false"><asp:Literal ID="litMessage" runat="server"/></asp:Panel><asp:HiddenField ID="hidRv" runat="server"/><section class="app-panel form-panel"><div class="route-summary-grid"><div><span>Severity</span><strong><asp:Literal ID="litSeverity" runat="server"/></strong></div><div><span>Category</span><strong><asp:Literal ID="litCategory" runat="server"/></strong></div><div><span>Status</span><strong><asp:Literal ID="litStatus" runat="server"/></strong></div><div><span>Trip</span><strong><asp:Literal ID="litTrip" runat="server"/></strong></div></div><hr/><h2>Description</h2><p class="fs-5"><asp:Literal ID="litDescription" runat="server"/></p><p class="cell-secondary">Reported by <asp:Literal ID="litDriver" runat="server"/> on <asp:Literal ID="litReported" runat="server"/></p><asp:Panel ID="pnlPrevious" runat="server" Visible="false" CssClass="alert alert-light"><asp:Literal ID="litPrevious" runat="server"/></asp:Panel><asp:Panel ID="pnlActions" runat="server"><asp:Label runat="server" AssociatedControlID="txtNote" CssClass="form-label" Text="Administrator note"/><asp:TextBox ID="txtNote" runat="server" CssClass="form-control" TextMode="MultiLine" Rows="4" MaxLength="1000"/><div class="form-actions"><asp:Button ID="btnReview" runat="server" CssClass="btn btn-outline-primary" Text="Mark reviewed" OnClick="btnReview_Click"/><asp:Button ID="btnResolve" runat="server" CssClass="btn btn-primary" Text="Resolve defect" OnClick="btnResolve_Click"/></div></asp:Panel></section></asp:Content>
