<%@ Page Title="Live tracking" Language="C#" MasterPageFile="~/Admin/Admin.Master" AutoEventWireup="true" CodeBehind="LiveTracking.aspx.cs" Inherits="ForteMove.Web.Admin.Tracking.LiveTrackingPage" %>
<asp:Content ID="Content1" ContentPlaceHolderID="MainContent" runat="server">
<header class="page-heading"><p class="section-kicker">Operations</p><h1>Live tracking</h1><p>Simulated service progress, based on the recorded Trip timeline.</p></header>
<section class="app-panel"><div class="fleet-filter"><asp:Label runat="server" AssociatedControlID="txtDate" Text="Service date"/><asp:TextBox ID="txtDate" runat="server" TextMode="Date" CssClass="form-control"/><asp:CheckBox ID="chkCompleted" runat="server" Text=" Include completed services"/><asp:Button ID="btnRefresh" runat="server" Text="Refresh services" CssClass="btn btn-primary" OnClick="btnRefresh_Click"/></div><asp:Label ID="lblMessage" runat="server" CssClass="text-danger"/>
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Service</th><th>Bus / Driver</th><th>Departure / actual start</th><th>Status / simulated segment</th><th></th></tr></thead><tbody><asp:Repeater ID="rptTrips" runat="server"><ItemTemplate><tr><td><strong><%#: Eval("Snapshot.TripCode") %></strong><span class="cell-secondary"><%#: Eval("Snapshot.RouteCode") %> - <%#: Eval("Snapshot.RouteName") %></span></td><td><%#: Eval("Snapshot.FleetNumber") %><span class="cell-secondary"><%#: Eval("Snapshot.DriverName") %> (<%#: Eval("Snapshot.EmployeeNumber") %>)</span></td><td><%#: Eval("Snapshot.ScheduledDepartureLocal") %><span class="cell-secondary"><%#: Eval("Snapshot.ActualStartLocal") ?? "Not started" %></span></td><td><%#: Eval("Snapshot.SafeStatus") %><span class="cell-secondary"><%#: Eval("Snapshot.CurrentStop") %> / <%#: Eval("Snapshot.NextStop") %></span><span class="cell-tertiary text-warning"><%#: Eval("Snapshot.AttentionMessage") %></span></td><td><a class="btn btn-outline-primary btn-sm" href='<%# ResolveUrl("~/Admin/Tracking/TripTracking.aspx?id="+Eval("TripId")) %>'>Track Trip</a></td></tr></ItemTemplate></asp:Repeater></tbody></table></div>
<asp:Panel ID="pnlEmpty" runat="server" CssClass="empty-state" Visible="false"><h2>No services to display</h2><p>Select another service date or review the assignment queue.</p></asp:Panel>
<p class="cell-secondary">Older unfinished services and ongoing overnight Trips remain visible for attention.</p></section>
</asp:Content>
