<%@ Page Title="Assignment details" Language="C#" MasterPageFile="~/Admin/Admin.Master" AutoEventWireup="true" CodeBehind="AssignmentDetails.aspx.cs" Inherits="ForteMove.Web.Admin.Assignments.AssignmentDetailsPage" %><asp:Content ID="Content1" ContentPlaceHolderID="MainContent" runat="server"><header class="page-heading page-heading-with-action"><div><p class="section-kicker">Trip assignment</p><h1><asp:Literal ID="litTripCode" runat="server"/></h1><p><asp:Literal ID="litTripContext" runat="server"/></p></div><a class="btn btn-outline-secondary" href="<%= ResolveUrl("~/Admin/Assignments/AssignmentQueue.aspx") %>">Assignment queue</a></header><asp:Panel ID="pnlMessage" runat="server" CssClass="alert alert-danger" Visible="false"><asp:Literal ID="litMessage" runat="server"/></asp:Panel><asp:HiddenField ID="hidTripRv" runat="server"/><asp:HiddenField ID="hidAssignmentRv" runat="server"/>
<asp:Panel ID="pnlReview" runat="server" CssClass="alert alert-warning" Visible="false"><strong>Review required.</strong> A Schedule change retained this Trip because it has operational history. Confirm the assignment remains appropriate, change/remove it, or acknowledge the unassigned Trip below.</asp:Panel>
<section class="app-panel form-panel"><h2>Current assignment</h2><asp:Panel ID="pnlCurrent" runat="server"><p><strong><asp:Literal ID="litCurrentDriver" runat="server"/></strong><br/><asp:Literal ID="litCurrentBus" runat="server"/></p></asp:Panel><asp:Panel ID="pnlUnassigned" runat="server"><p>This Trip is currently unassigned.</p></asp:Panel><div class="row g-3"><div class="col-md-7"><label class="form-label">Eligible Driver and bus pair</label><asp:DropDownList ID="ddlAlternative" runat="server" CssClass="form-select"/></div><div class="col-md-5"><label class="form-label">Decision reason</label><asp:TextBox ID="txtReason" runat="server" CssClass="form-control" MaxLength="500"/></div></div><div class="form-actions"><asp:Button ID="btnAssign" runat="server" CssClass="btn btn-primary" Text="Assign selected pair" OnClick="btnAssign_Click"/><asp:Button ID="btnChange" runat="server" CssClass="btn btn-primary" Text="Change assignment" OnClick="btnChange_Click"/><asp:Button ID="btnRemove" runat="server" CssClass="btn btn-outline-danger" Text="Remove assignment" OnClick="btnRemove_Click"/><asp:Button ID="btnResolve" runat="server" CssClass="btn btn-outline-secondary" Text="Mark review complete" OnClick="btnResolve_Click"/></div></section>
<section class="app-panel mt-4"><h2>Assignment history</h2><asp:Repeater ID="rptHistory" runat="server"><ItemTemplate><div class="border-top py-3"><strong><%#: Eval("EmployeeNumber") %> · <%#: Eval("DriverName") %></strong><span class="cell-secondary"><%#: Eval("FleetNumber") %> · <%#: Eval("DecisionType") %> · <%#: Eval("AssignedUtc", "{0:g}") %> UTC</span><span class="cell-tertiary"><%#: FormatHistory(Container.DataItem) %></span></div></ItemTemplate></asp:Repeater><asp:Panel ID="pnlNoHistory" runat="server" CssClass="empty-state"><p>No assignment decisions have been recorded.</p></asp:Panel></section></asp:Content>
