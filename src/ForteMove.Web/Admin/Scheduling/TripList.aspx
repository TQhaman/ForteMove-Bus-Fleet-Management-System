<%@ Page Title="Trips" Language="C#" MasterPageFile="~/Admin/Admin.Master" AutoEventWireup="true" CodeBehind="TripList.aspx.cs" Inherits="ForteMove.Web.Admin.Scheduling.TripList" %>
<asp:Content ID="Content1" ContentPlaceHolderID="MainContent" runat="server">
<header class="page-heading page-heading-with-action"><div><p class="section-kicker">Scheduling</p><h1>Trips</h1><p>Review dated services generated from recurring Schedules.</p></div><a class="btn btn-primary" href="<%= ResolveUrl("~/Admin/Scheduling/CreateSchedule.aspx") %>">Create schedule</a></header>
<section class="app-panel filter-panel" aria-label="Trip filters"><div class="row g-3 align-items-end"><div class="col-md-3"><asp:Label runat="server" AssociatedControlID="txtServiceDate" CssClass="form-label" Text="Service date"/><asp:TextBox ID="txtServiceDate" runat="server" CssClass="form-control" TextMode="Date"/></div><div class="col-md-4"><asp:Label runat="server" AssociatedControlID="ddlRoute" CssClass="form-label" Text="Route"/><asp:DropDownList ID="ddlRoute" runat="server" CssClass="form-select"/></div><div class="col-md-3"><asp:Label runat="server" AssociatedControlID="ddlStatus" CssClass="form-label" Text="Trip status"/><asp:DropDownList ID="ddlStatus" runat="server" CssClass="form-select"/></div><div class="col-md-2 filter-actions"><asp:Button ID="btnApply" runat="server" CssClass="btn btn-primary" Text="Apply" OnClick="btnApply_Click"/><asp:LinkButton ID="btnClear" runat="server" CssClass="btn btn-link" Text="Clear" CausesValidation="false" OnClick="btnClear_Click"/></div></div></section>
<asp:Panel ID="pnlResults" runat="server" CssClass="app-panel route-panel" Visible="false"><div class="fleet-panel-heading"><div><h2>Generated Trips</h2><p><asp:Literal ID="litCount" runat="server"/></p></div></div><div class="table-responsive"><table class="table route-table align-middle mb-0"><thead><tr><th>Trip</th><th>Service date</th><th>Departure</th><th>Expected finish</th><th>Route</th><th>Journey</th><th>Status</th><th>Assignment</th></tr></thead><tbody><asp:Repeater ID="rptTrips" runat="server"><ItemTemplate><tr><td><strong class="route-code"><%#: Eval("TripCode") %></strong></td><td><%#: FormatDate(Eval("ServiceDate")) %></td><td><%#: FormatTime(Eval("ScheduledDepartureTime")) %></td><td><%#: FormatFinish(Eval("ServiceDate"),Eval("ExpectedFinishLocal")) %></td><td><strong><%#: Eval("RouteName") %></strong><span class="cell-secondary"><%#: Eval("RouteCode") %></span></td><td><%#: Eval("OriginName") %><span class="cell-tertiary">to <%#: Eval("DestinationName") %></span></td><td><span class='<%# GetStatusCss(Eval("Status"),Eval("RequiresReview")) %>'><%#: FormatStatus(Eval("Status"),Eval("RequiresReview")) %></span></td><td><span><%#: FormatAssignment(Container.DataItem) %></span><span class="cell-tertiary"><a href='<%# ResolveUrl("~/Admin/Assignments/AssignmentDetails.aspx?id="+Eval("TripId")) %>'>Review</a></span></td></tr></ItemTemplate></asp:Repeater></tbody></table></div></asp:Panel>
<asp:Panel ID="pnlEmpty" runat="server" CssClass="app-panel empty-state" Visible="false"><h2>No Trips match this view</h2><p>Adjust the filters or create a recurring Schedule to generate Trips.</p></asp:Panel>
</asp:Content>
