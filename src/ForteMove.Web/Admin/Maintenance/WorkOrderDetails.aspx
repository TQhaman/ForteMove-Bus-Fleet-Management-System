<%@ Page Title="Work order details" Language="C#" MasterPageFile="~/Admin/Admin.Master" AutoEventWireup="true" CodeBehind="WorkOrderDetails.aspx.cs" Inherits="ForteMove.Web.Admin.Maintenance.WorkOrderDetailsPage" %>
<asp:Content ID="BodyContent" ContentPlaceHolderID="MainContent" runat="server">
<header class="page-heading"><div><p class="eyebrow">Maintenance</p><h1>Work order details</h1></div><a class="btn btn-outline-primary" href="Overview.aspx">Maintenance overview</a></header>
<asp:Panel ID="pnlMessage" runat="server" Visible="false" CssClass="alert alert-danger" role="alert"><asp:Literal ID="litMessage" runat="server" /></asp:Panel>
<section class="surface-card"><asp:Literal ID="litContext" runat="server" /><asp:HyperLink ID="lnkHistory" runat="server" Text="Bus service history" CssClass="btn btn-outline-primary" /><asp:HyperLink ID="lnkComplete" runat="server" Text="Complete work" CssClass="btn btn-primary" /></section><asp:Panel ID="pnlStart" runat="server" CssClass="surface-card"><h2>Review before starting maintenance</h2><p>Starting will make the bus unavailable, keep its assignments for administrator review, and cancel pending fuel requests and unused vouchers. Purchased tickets remain unchanged.</p><asp:Literal ID="litImpact" runat="server" /><asp:CheckBox ID="chkConfirm" runat="server" Text=" I have reviewed the affected work and authorizations." /><div class="maintenance-actions"><asp:Button ID="btnStart" runat="server" Text="Start maintenance" CssClass="btn btn-primary" OnClick="Start_Click" /></div></asp:Panel><asp:Panel ID="pnlActions" runat="server" CssClass="surface-card"><h2>Record progress or cancel</h2><div class="form-group"><asp:Label runat="server" AssociatedControlID="txtNote" Text="Progress note or cancellation reason" /><asp:TextBox ID="txtNote" runat="server" CssClass="form-control" TextMode="MultiLine" Rows="4" MaxLength="1000" /></div><div class="maintenance-actions"><asp:Button ID="btnProgress" runat="server" Text="Record progress" CssClass="btn btn-primary" OnClick="Progress_Click" /><asp:Button ID="btnCancel" runat="server" Text="Cancel work order" CssClass="btn btn-primary" OnClick="Cancel_Click" /></div><p>Cancellation preserves all history. A bus already Under maintenance stays there until an approved Return to Service.</p></asp:Panel><section class="surface-card"><h2>Recorded progress and status changes</h2><asp:Literal ID="litHistory" runat="server" /></section>
</asp:Content>

