<%@ Page Title="Complete work order" Language="C#" MasterPageFile="~/Admin/Admin.Master" AutoEventWireup="true" CodeBehind="CompleteWorkOrder.aspx.cs" Inherits="ForteMove.Web.Admin.Maintenance.CompleteWorkOrderPage" %>
<asp:Content ID="BodyContent" ContentPlaceHolderID="MainContent" runat="server">
<header class="page-heading"><div><p class="eyebrow">Maintenance</p><h1>Complete work order</h1></div><a class="btn btn-outline-primary" href="Overview.aspx">Maintenance overview</a></header>
<asp:Panel ID="pnlMessage" runat="server" Visible="false" CssClass="alert alert-danger" role="alert"><asp:Literal ID="litMessage" runat="server" /></asp:Panel>
<section class="surface-card"><asp:Literal ID="litContext" runat="server" /><p>Completion records service evidence. The bus stays Under maintenance until Return to Service is approved separately.</p><div class="form-group"><asp:Label runat="server" AssociatedControlID="txtOdo" Text="Verified service odometer (km)" /><asp:TextBox ID="txtOdo" runat="server" CssClass="form-control"  /></div><div class="form-group"><asp:Label runat="server" AssociatedControlID="txtWork" Text="Work performed" /><asp:TextBox ID="txtWork" runat="server" CssClass="form-control" TextMode="MultiLine" Rows="4" MaxLength="1000" /></div><div class="form-group"><asp:Label runat="server" AssociatedControlID="txtNote" Text="Completion note" /><asp:TextBox ID="txtNote" runat="server" CssClass="form-control" TextMode="MultiLine" Rows="3" MaxLength="1000" /></div><div class="maintenance-form-grid"><div class="form-group"><asp:Label runat="server" AssociatedControlID="txtReference" Text="External reference (optional)" /><asp:TextBox ID="txtReference" runat="server" CssClass="form-control" MaxLength="100" /></div><div class="form-group"><asp:Label runat="server" AssociatedControlID="txtCost" Text="Recorded cost in rand (optional)" /><asp:TextBox ID="txtCost" runat="server" CssClass="form-control"  /></div></div><asp:Panel ID="pnlDefect" runat="server"><asp:CheckBox ID="chkResolve" runat="server" Text=" Also resolve the linked defect" /><div class="form-group"><asp:Label runat="server" AssociatedControlID="txtResolution" Text="Defect resolution note (required if resolving)" /><asp:TextBox ID="txtResolution" runat="server" CssClass="form-control" TextMode="MultiLine" Rows="3" MaxLength="1000" /></div></asp:Panel><asp:Button ID="btnComplete" runat="server" Text="Record completion" CssClass="btn btn-primary" OnClick="Complete_Click" /></section>
</asp:Content>

