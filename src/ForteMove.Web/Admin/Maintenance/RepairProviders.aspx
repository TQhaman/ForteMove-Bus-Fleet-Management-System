<%@ Page Title="Repair providers" Language="C#" MasterPageFile="~/Admin/Admin.Master" AutoEventWireup="true" CodeBehind="RepairProviders.aspx.cs" Inherits="ForteMove.Web.Admin.Maintenance.RepairProvidersPage" %>
<asp:Content ID="BodyContent" ContentPlaceHolderID="MainContent" runat="server">
<header class="page-heading"><div><p class="eyebrow">Maintenance</p><h1>Repair providers</h1></div><a class="btn btn-outline-primary" href="Overview.aspx">Maintenance overview</a></header>
<asp:Panel ID="pnlMessage" runat="server" Visible="false" CssClass="alert alert-danger" role="alert"><asp:Literal ID="litMessage" runat="server" /></asp:Panel>
<section class="surface-card"><asp:Literal ID="litProviders" runat="server" /></section><section class="surface-card"><h2><asp:Literal ID="litEditor" runat="server" /></h2><p>External repair companies do not sign in. Inactive providers remain in service history.</p><div class="maintenance-form-grid"><div class="form-group"><asp:Label runat="server" AssociatedControlID="txtName" Text="Provider name" /><asp:TextBox ID="txtName" runat="server" CssClass="form-control" MaxLength="150" /></div><div class="form-group"><asp:Label runat="server" AssociatedControlID="txtArea" Text="Area or address description" /><asp:TextBox ID="txtArea" runat="server" CssClass="form-control" MaxLength="250" /></div><div class="form-group"><asp:Label runat="server" AssociatedControlID="txtPhone" Text="Phone (optional)" /><asp:TextBox ID="txtPhone" runat="server" CssClass="form-control" MaxLength="30" /></div><div class="form-group"><asp:Label runat="server" AssociatedControlID="txtEmail" Text="Email (optional)" /><asp:TextBox ID="txtEmail" runat="server" CssClass="form-control" MaxLength="254" /></div></div><asp:CheckBox ID="chkActive" runat="server" Text=" Active provider" Checked="true" /><div class="maintenance-actions"><asp:Button ID="btnSave" runat="server" Text="Save provider" CssClass="btn btn-primary" OnClick="Save_Click" /><a class="btn btn-outline-primary" href="RepairProviders.aspx">New provider</a></div></section>
</asp:Content>

