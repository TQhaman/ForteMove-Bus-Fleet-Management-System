<%@ Page Title="Review Fuel Request" Language="C#" MasterPageFile="~/Admin/Admin.Master" AutoEventWireup="true" CodeBehind="RequestDetails.aspx.cs" Inherits="ForteMove.Web.Admin.Fuel.RequestDetailsPage"  %>
<asp:Content ID="Main" ContentPlaceHolderID="MainContent" runat="server">
<header class="page-heading"><div><p class="section-kicker">Fuel</p><h1>Review Fuel Request</h1></div></header>
<nav class="fuel-subnavigation" aria-label="Fuel navigation"><a  href="<%= ResolveUrl("~/Admin/Fuel/Requests.aspx") %>">Requests</a><a  href="<%= ResolveUrl("~/Admin/Fuel/Vouchers.aspx") %>">Vouchers</a><a  href="<%= ResolveUrl("~/Admin/Fuel/Transactions.aspx") %>">Transactions</a><a  href="<%= ResolveUrl("~/Admin/Fuel/Stations.aspx") %>">Stations</a><a  href="<%= ResolveUrl("~/Admin/Fuel/PrototypeTerminal.aspx") %>">Prototype Terminal</a></nav>
<asp:Panel ID="pnlMessage" runat="server" CssClass="alert alert-danger" Visible="false" role="alert"><asp:Literal ID="litMessage" runat="server"/></asp:Panel>
<section class="app-panel form-panel"><asp:Literal ID="litDetails" runat="server"/><asp:Panel ID="pnlWarnings" runat="server" CssClass="alert alert-warning" Visible="false"><asp:Literal ID="litWarnings" runat="server"/></asp:Panel><asp:HyperLink ID="lnkVoucher" runat="server" CssClass="btn btn-primary" Text="View Voucher" Visible="false"/>
<asp:Panel ID="pnlActions" runat="server"><h2>Authorization</h2><p>Authorize supply only. Capacity is not the current fuel or charge level.</p><div class="form-grid"><div class="form-field"><label for="<%= txtQuantity.ClientID %>">Approved quantity</label><asp:TextBox ID="txtQuantity" runat="server" CssClass="form-control" TextMode="Number" step="0.01"/></div><span class="field-help"><asp:Literal ID="litUnit" runat="server"/></span><div class="form-field"><label for="<%= txtAmount.ClientID %>">Approved amount (Rand)</label><asp:TextBox ID="txtAmount" runat="server" CssClass="form-control" TextMode="Number" step="0.01"/></div><div class="form-field"><label for="<%= ddlStations.ClientID %>">Approved Fuel Station</label><asp:DropDownList ID="ddlStations" runat="server" CssClass="form-select" AutoPostBack="true" OnSelectedIndexChanged="SelectStation"/></div><div class="form-field"><label for="<%= txtUntil.ClientID %>">Valid until (South African time)</label><asp:TextBox ID="txtUntil" runat="server" CssClass="form-control" TextMode="DateTimeLocal"/></div><div class="form-field"><label for="<%= txtNote.ClientID %>">Approval note (optional)</label><asp:TextBox ID="txtNote" runat="server" CssClass="form-control" TextMode="MultiLine" MaxLength="500"/></div><asp:Button ID="btnApprove" runat="server" Text="Approve and create Voucher" CssClass="btn btn-primary" OnClick="Approve"/></div><hr/><h2>Reject request</h2><div class="form-field"><label for="<%= txtReject.ClientID %>">Rejection reason</label><asp:TextBox ID="txtReject" runat="server" CssClass="form-control" TextMode="MultiLine" Rows="3" MaxLength="500"/></div><asp:Button ID="btnReject" runat="server" CssClass="btn btn-outline-danger" Text="Reject request" OnClick="Reject"/></asp:Panel></section>
</asp:Content>
