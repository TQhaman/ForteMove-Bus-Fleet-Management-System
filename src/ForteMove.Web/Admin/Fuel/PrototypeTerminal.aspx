<%@ Page Title="Prototype Fuel Station Terminal" Language="C#" MasterPageFile="~/Admin/Admin.Master" AutoEventWireup="true" CodeBehind="PrototypeTerminal.aspx.cs" Inherits="ForteMove.Web.Admin.Fuel.PrototypeTerminalPage" ViewStateEncryptionMode="Always" %>
<asp:Content ID="Main" ContentPlaceHolderID="MainContent" runat="server">
<header class="page-heading"><div><p class="section-kicker">Fuel</p><h1>Prototype Fuel Station Terminal</h1></div></header>
<nav class="fuel-subnavigation" aria-label="Fuel navigation"><a  href="<%= ResolveUrl("~/Admin/Fuel/Requests.aspx") %>">Requests</a><a  href="<%= ResolveUrl("~/Admin/Fuel/Vouchers.aspx") %>">Vouchers</a><a  href="<%= ResolveUrl("~/Admin/Fuel/Transactions.aspx") %>">Transactions</a><a  href="<%= ResolveUrl("~/Admin/Fuel/Stations.aspx") %>">Stations</a><a aria-current="page" class="active" href="<%= ResolveUrl("~/Admin/Fuel/PrototypeTerminal.aspx") %>">Prototype Terminal</a></nav>
<asp:Panel ID="pnlMessage" runat="server" CssClass="alert alert-danger" Visible="false" role="alert"><asp:Literal ID="litMessage" runat="server"/></asp:Panel>
<section class="app-panel form-panel"><p>This protected demonstration utility simulates external Station redemption. No real payment or supply provider is connected.</p><div class="form-field"><label for="<%= ddlStations.ClientID %>">Configured Fuel Station</label><asp:DropDownList ID="ddlStations" runat="server" CssClass="form-select"/></div><div class="form-field"><label for="<%= txtToken.ClientID %>">Scan, paste or enter Voucher token</label><asp:TextBox ID="txtToken" runat="server" CssClass="form-control" TextMode="Password" MaxLength="60" autocomplete="off"/></div><asp:Button ID="btnReview" runat="server" Text="Review Voucher" CssClass="btn btn-primary" OnClick="Review"/><asp:Panel ID="pnlReview" runat="server" Visible="false"><hr/><asp:Literal ID="litDetails" runat="server"/><p><asp:Literal ID="litWarnings" runat="server"/></p><asp:Button ID="btnConfirm" runat="server" Text="Confirm redemption" CssClass="btn btn-primary" OnClick="Confirm"/></asp:Panel></section>
</asp:Content>
