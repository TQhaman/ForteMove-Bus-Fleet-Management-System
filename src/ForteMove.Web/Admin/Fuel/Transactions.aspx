<%@ Page Title="Fuel Transactions" Language="C#" MasterPageFile="~/Admin/Admin.Master" AutoEventWireup="true" CodeBehind="Transactions.aspx.cs" Inherits="ForteMove.Web.Admin.Fuel.TransactionsPage"  %>
<asp:Content ID="Main" ContentPlaceHolderID="MainContent" runat="server">
<header class="page-heading"><div><p class="section-kicker">Fuel</p><h1>Fuel Transactions</h1></div></header>
<nav class="fuel-subnavigation" aria-label="Fuel navigation"><a  href="<%= ResolveUrl("~/Admin/Fuel/Requests.aspx") %>">Requests</a><a  href="<%= ResolveUrl("~/Admin/Fuel/Vouchers.aspx") %>">Vouchers</a><a aria-current="page" class="active" href="<%= ResolveUrl("~/Admin/Fuel/Transactions.aspx") %>">Transactions</a><a  href="<%= ResolveUrl("~/Admin/Fuel/Stations.aspx") %>">Stations</a><a  href="<%= ResolveUrl("~/Admin/Fuel/PrototypeTerminal.aspx") %>">Prototype Terminal</a></nav>
<asp:Panel ID="pnlMessage" runat="server" CssClass="alert alert-danger" Visible="false" role="alert"><asp:Literal ID="litMessage" runat="server"/></asp:Panel>
<section class="app-panel"><p>Read-only history of prototype redemption. These are not payment transactions.</p><div class="fuel-filter-row"><div class="form-field"><label for="<%= txtSearch.ClientID %>">Search</label><asp:TextBox ID="txtSearch" runat="server" CssClass="form-control" MaxLength="100"/></div><asp:Button ID="btnFilter" runat="server" Text="Search" CssClass="btn btn-primary" OnClick="Filter"/></div><div class="table-responsive"><asp:GridView ID="grid" runat="server" AutoGenerateColumns="false" CssClass="table app-table" EmptyDataText="No Fuel Transactions match this search."><Columns><asp:HyperLinkField HeaderText="Transaction" DataTextField="Code" DataNavigateUrlFields="Id" DataNavigateUrlFormatString="TransactionDetails.aspx?id={0}"/><asp:BoundField HeaderText="Voucher" DataField="Voucher"/><asp:BoundField HeaderText="Trip" DataField="Trip"/><asp:BoundField HeaderText="Bus" DataField="Bus"/><asp:BoundField HeaderText="Station" DataField="Station"/><asp:BoundField HeaderText="Quantity" DataField="Quantity"/><asp:BoundField HeaderText="Value" DataField="Amount"/><asp:BoundField HeaderText="Redeemed" DataField="Time"/></Columns></asp:GridView></div></section>
</asp:Content>
