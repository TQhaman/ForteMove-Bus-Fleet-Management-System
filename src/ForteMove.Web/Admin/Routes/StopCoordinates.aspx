<%@ Page Title="Stop coordinates" Language="C#" MasterPageFile="~/Admin/Admin.Master" AutoEventWireup="true" CodeBehind="StopCoordinates.aspx.cs" Inherits="ForteMove.Web.Admin.Routes.StopCoordinatesPage" %>
<asp:Content ID="Content1" ContentPlaceHolderID="MainContent" runat="server"><header class="page-heading"><p class="section-kicker">Route network</p><h1>Stop coordinates</h1><p>Correct a Stop's stored location for simulated service tracking.</p></header><asp:Panel ID="pnlMessage" runat="server" Visible="false" CssClass="alert alert-danger"><asp:Literal ID="litMessage" runat="server"/></asp:Panel><asp:Panel ID="pnlEditor" runat="server" CssClass="app-panel form-panel"><h2><asp:Literal ID="litStop" runat="server"/></h2><p><asp:Literal ID="litArea" runat="server"/></p><p><strong>Used by:</strong> <asp:Literal ID="litRoutes" runat="server"/></p><p class="alert alert-info">This shared Stop is updated for every Route using it. Corrections also affect historical and Completed Trip maps.</p><div class="row g-3"><div class="col-md-6"><asp:Label runat="server" AssociatedControlID="txtLatitude" Text="Latitude" CssClass="form-label"/><asp:TextBox ID="txtLatitude" runat="server" CssClass="form-control" inputmode="decimal"/></div><div class="col-md-6"><asp:Label runat="server" AssociatedControlID="txtLongitude" Text="Longitude" CssClass="form-label"/><asp:TextBox ID="txtLongitude" runat="server" CssClass="form-control" inputmode="decimal"/></div></div><p class="cell-secondary mt-2">Enter both coordinates using a decimal point and up to six decimal places, or leave both empty.</p><asp:Panel ID="pnlWarning" runat="server" Visible="false" CssClass="alert alert-warning"><strong>Started Trips are using this Stop.</strong><p><asp:Literal ID="litWarning" runat="server"/></p><asp:CheckBox ID="chkAcknowledge" runat="server" Text=" I understand this correction immediately affects these Trips' simulated tracking."/></asp:Panel><div class="form-actions"><asp:Button ID="btnSave" runat="server" Text="Save coordinates" CssClass="btn btn-primary" OnClick="btnSave_Click"/><a class="btn btn-outline-secondary" href='<%= ResolveUrl("~/Admin/Routes/RouteList.aspx") %>'>Route list</a></div></asp:Panel></asp:Content>
